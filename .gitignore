# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# electron desktop shell build output
/electron/dist
/electron/release
# The WASAPI capture helper is deliberately NOT ignored: bin/golive-audiocap.exe
# and its .sha256 are committed, built by .github/workflows/build-audiocap.yml.
# That is what lets a clone run and package the app without MSVC and a Windows
# SDK installed — impossible on macOS and Linux, and a multi-GB install on
# Windows. The .sha256 records which audiocap.cpp the .exe was built from, so a
# stale binary is detectable rather than silent.
#
# Only the compiler's intermediates are ignored.
/electron/native/obj
/electron/native/bin/*.obj
/electron/native/bin/*.pdb

# Android shell build output — the android/ project itself (manifest,
# gradle files, MainActivity, resources) is committed like electron/dist's
# sources are, but everything below is either regenerated by `cap sync`/
# gradle or is a machine-local path/secret that has no business in git.
/android/app/build
/android/app/release
/android/build
/android/capacitor-cordova-android-plugins
/android/.gradle
/android/local.properties
/android/keystore.properties
/android/**/*.keystore
/android/**/*.jks
/android/app/src/main/assets/public
/android/app/src/main/assets/capacitor.config.json
