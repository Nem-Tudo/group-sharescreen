<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the app (App/App.entitlements): the only channel between
	     the two processes — see App/BroadcastShared.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.me.nemtudo.golive</string>
	</array>
</dict>
</plist>
