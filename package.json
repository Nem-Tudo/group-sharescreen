{
  "name": "sharescreen",
  "version": "0.1.16",
  "private": true,
  "description": "GoLive — compartilhe sua tela com quem estiver na mesma sala.",
  "author": "NemTudo",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./lib/ts-resolve.mjs --experimental-strip-types --test lib/*.test.mts",
    "electron:typecheck": "tsc --noEmit -p electron/tsconfig.json",
    "electron:native": "node electron/native/build.mjs",
    "electron:build": "node electron/native/build.mjs && node electron/build.mjs",
    "electron:dev": "npm run electron:build && cross-env GOLIVE_APP_URL=http://localhost:3000 electron .",
    "electron:start": "npm run electron:build && electron .",
    "electron:pack": "npm run electron:build && electron-builder --dir",
    "electron:dist": "npm run electron:build && electron-builder",
    "preversion": "npm run typecheck && npm run electron:typecheck && npm run electron:build && npm test",
    "postversion": "git push --follow-tags",
    "release": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "@tailwindcss/postcss": "^4",
    "@tippyjs/react": "^4.2.6",
    "leaflet": "^1.9.4",
    "next": "16.3.1",
    "ntpopups": "^1.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
