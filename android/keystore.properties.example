# Copy this file to android/keystore.properties (already .gitignore'd — see
# the root .gitignore's "Android shell build output" section) and fill it in
# with the release key used to sign the Play Store build. Never commit the
# real file or the .jks/.keystore it points at: Play ties a listing to the
# key that first uploaded it, so a leaked key is not something you rotate
# away from, only something you lose the listing over.
#
# Generate one (only once — keep the resulting file *and* these passwords
# somewhere durable, e.g. a password manager, not just this checkout):
#   keytool -genkeypair -v -keystore golive-release.jks -alias golive \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# With this file absent, android/app/build.gradle falls back to an
# unsigned/debug-signed release build — enough to confirm the app still
# builds, not enough to upload to Play.

storeFile=../golive-release.jks
storePassword=
keyAlias=golive
keyPassword=
